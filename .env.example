# Copy this file to `.env` and fill in real values locally.
# `.env` is git-ignored — never commit it.
# Document every new environment variable here.
#
# Loading conventions (choose one and stick with it once introduced):
#   - `--dart-define-from-file=.env` at build/run time, or
#   - `flutter_dotenv` loaded at app startup.
#
# No third-party services are wired up yet. Add variables below as services
# are introduced (Firebase, Google Maps, Gemini, Sentry, RevenueCat, etc.).

# --- App environment ---------------------------------------------------------
APP_ENV=                 # dev | staging | prod
